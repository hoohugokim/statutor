{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python3 core/statutor_core.py hook",
        "matcher": "Write|StrReplace|Shell|Delete|MultiEdit|NotebookEdit|ApplyPatch",
        "timeout": 30
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 core/statutor_core.py hook",
        "timeout": 30
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 core/statutor_core.py hook",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "python3 core/statutor_core.py hook --stop",
        "timeout": 30
      }
    ]
  }
}
